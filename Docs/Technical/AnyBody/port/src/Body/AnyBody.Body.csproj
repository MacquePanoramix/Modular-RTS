<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>WonderGather.AnyBody</RootNamespace>
    <AssemblyName>WonderGather.AnyBody.Body</AssemblyName>
    <Optimize>true</Optimize>
    <!-- The source is in the game (Directory.Build.props: AnyBodySrc). -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(AnyBodySrc)Body\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\AnyBody.Core.csproj" />
  </ItemGroup>
</Project>
