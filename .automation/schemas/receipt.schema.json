{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Modular-RTS shadow receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "project_id",
    "created_at",
    "task_id",
    "run_id",
    "attempt",
    "executor_id",
    "model_id",
    "inputs",
    "started_at",
    "finished_at",
    "artifacts",
    "candidate_sha",
    "checks",
    "observed_usage",
    "outcome",
    "failure_class",
    "recovery_pointer"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "created_at": {
      "type": "string",
      "format": "utc-z"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "executor_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "model_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_sha",
        "plan_version",
        "policy_version",
        "acceptance_version",
        "generation",
        "source_manifest"
      ],
      "properties": {
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "plan_version": {
          "type": "integer",
          "minimum": 1
        },
        "policy_version": {
          "type": "integer",
          "minimum": 1
        },
        "acceptance_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "source_manifest": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "revision"
            ],
            "properties": {
              "path": {
                "type": "string",
                "format": "repo-path",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        }
      }
    },
    "started_at": {
      "type": "string",
      "format": "utc-z"
    },
    "finished_at": {
      "type": "string",
      "format": "utc-z"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "format": "repo-path",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "candidate_sha": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "log_path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "unverified"
            ]
          },
          "log_path": {
            "anyOf": [
              {
                "type": "string",
                "format": "repo-path",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "observed_usage": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_tokens",
            "output_tokens"
          ],
          "properties": {
            "input_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "output_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "candidate",
        "blocked",
        "failed",
        "verified"
      ]
    },
    "failure_class": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "CONTEXT",
            "REQUIREMENT",
            "IMPLEMENTATION",
            "VERIFICATION",
            "INFRASTRUCTURE",
            "QUOTA",
            "AUTH",
            "PERMISSION",
            "SECURITY"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "recovery_pointer": {
      "anyOf": [
        {
          "type": "string",
          "format": "repo-path",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
