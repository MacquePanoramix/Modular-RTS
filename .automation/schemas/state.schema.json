{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Modular-RTS shadow state v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "project_id",
    "created_at",
    "plan_version",
    "policy_version",
    "paused",
    "stopped",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "created_at": {
      "type": "string",
      "format": "utc-z"
    },
    "plan_version": {
      "type": "integer",
      "minimum": 1
    },
    "policy_version": {
      "type": "integer",
      "minimum": 1
    },
    "paused": {
      "type": "boolean"
    },
    "stopped": {
      "type": "boolean"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "id",
          "project_id",
          "created_at",
          "objective",
          "dependencies",
          "base_sha",
          "plan_version",
          "policy_version",
          "acceptance_version",
          "allowed_paths",
          "source_manifest",
          "expected_artifacts",
          "checks",
          "tier",
          "max_attempts",
          "timeout_minutes",
          "escalate_on",
          "status",
          "priority",
          "critical_path_rank",
          "generation",
          "attempts",
          "lease"
        ],
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1
          },
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "project_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "created_at": {
            "type": "string",
            "format": "utc-z"
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "uniqueItems": true
          },
          "base_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "plan_version": {
            "type": "integer",
            "minimum": 1
          },
          "policy_version": {
            "type": "integer",
            "minimum": 1
          },
          "acceptance_version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "allowed_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "repo-pattern",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "source_manifest": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256",
                "revision"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "format": "repo-path",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "revision": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                }
              }
            }
          },
          "expected_artifacts": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "repo-path",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "tier": {
            "type": "string",
            "enum": [
              "worker",
              "architect",
              "reviewer"
            ]
          },
          "max_attempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "timeout_minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "escalate_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "READY",
              "RUNNING",
              "VERIFYING",
              "INTEGRATING",
              "DONE",
              "WAITING_HUMAN",
              "WAITING_QUOTA",
              "WAITING_CAPABILITY",
              "FAILED",
              "CANCELLED"
            ]
          },
          "priority": {
            "type": "integer",
            "minimum": 0
          },
          "critical_path_rank": {
            "type": "integer",
            "minimum": 0
          },
          "generation": {
            "type": "integer",
            "minimum": 0
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "lease": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "task_id",
                  "run_id",
                  "host_id",
                  "generation",
                  "claimed_at",
                  "heartbeat_at",
                  "expires_at"
                ],
                "properties": {
                  "task_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                  },
                  "run_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                  },
                  "host_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                  },
                  "generation": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "claimed_at": {
                    "type": "string",
                    "format": "utc-z"
                  },
                  "heartbeat_at": {
                    "type": "string",
                    "format": "utc-z"
                  },
                  "expires_at": {
                    "type": "string",
                    "format": "utc-z"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
