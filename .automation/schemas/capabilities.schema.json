{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Modular-RTS shadow capabilities v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "project_id",
    "created_at",
    "host_os",
    "tools",
    "auth_mode",
    "models",
    "integrations",
    "quota_observability",
    "probe_time",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "created_at": {
      "type": "string",
      "format": "utc-z"
    },
    "host_os": {
      "type": "string",
      "minLength": 1
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "observed",
              "unverified",
              "unavailable"
            ]
          }
        }
      }
    },
    "auth_mode": {
      "type": "string",
      "enum": [
        "unverified",
        "chatgpt",
        "api"
      ]
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "efforts",
          "status",
          "observed_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "efforts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "status": {
            "type": "string",
            "enum": [
              "observed",
              "unverified"
            ]
          },
          "observed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "utc-z"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "observed",
              "unverified",
              "unavailable"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "quota_observability": {
      "type": "string",
      "enum": [
        "unverified",
        "available",
        "unavailable"
      ]
    },
    "probe_time": {
      "type": "string",
      "format": "utc-z"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
